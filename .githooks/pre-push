#!/bin/sh
# Refuses a push that would publish something it should not. This repository
# is public. Install once per clone: git config core.hooksPath .githooks
#
# - every PHP file the push changes must pass php -l;
# - commit messages and added lines must not name things private to the
#   repository this plugin is developed beside (task list, decision records,
#   milestone and journey ids) or carry assistant attribution; SVG path
#   data (d="M26.5 ...") is left out of that check, as its moveto commands
#   read as milestone ids;
# - gitleaks must find no secret in the pushed commits.
set -eu

internal='\bCUJ\b|\bADR-?[0-9]{2,4}\b|\bM[0-9]{2,3}(\.[0-9]+)?\b|TASKS\.md|SESSION_LOG|PROD-(PLAN|RESULTS|PROGRESS)|[Cc]ontrol[ -][Pp]lane|Co-Authored-By: Claude|Claude-Session:|Generated with \[Claude Code\]'

cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
fail=0
while read -r _ local_sha _ remote_sha; do
	[ "$local_sha" = "$zero" ] && continue
	base=$remote_sha
	[ "$base" = "$zero" ] && base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "")
	if [ -n "$base" ]; then
		files=$(git diff --name-only --diff-filter=AM "$base" "$local_sha" -- '*.php')
		range="$base..$local_sha"
	else
		files=$(git ls-tree -r --name-only "$local_sha" -- '*.php')
		range="$local_sha"
	fi
	for f in $files; do
		if ! git show "$local_sha:$f" | php -l >/dev/null 2>&1; then
			echo "Error: $f does not parse in the pushed commit (php -l)." >&2
			fail=1
		fi
	done
	if msgs=$(git log --format='%h %s%n%b' "$range" | grep -nE "$internal"); then
		echo "Error: a commit message being pushed names something private:" >&2
		echo "$msgs" | head -5 >&2
		fail=1
	fi
	added=$(git log -p --format='commit %h' "$range" -- . ':(exclude).githooks/pre-push' |
		awk '/^commit [0-9a-f]+$/ {c=$2} /^\+[^+]/ {print c": "$0}' |
		sed -E 's/ d="[^"]*"//g' | grep -E "$internal" || true)
	if [ -n "$added" ]; then
		echo "Error: lines being pushed name something private:" >&2
		echo "$added" | head -5 >&2
		echo "    This repository is public. Say what the code does, not which task found it." >&2
		fail=1
	fi
	if command -v gitleaks >/dev/null; then
		if ! gitleaks git --no-banner --redact --exit-code 1 --log-opts="$range" . >/dev/null 2>&1; then
			echo "Error: gitleaks found a secret in the commits being pushed. Remove it and rewrite the commit." >&2
			fail=1
		fi
	else
		echo "Error: gitleaks is not installed, so the push was not scanned for secrets: brew install gitleaks" >&2
		fail=1
	fi
done
exit $fail
